# ─────────────────────────────────────────────────────────────
# Перигей — переменные окружения. Скопируй в .env и заполни.
# Реальный .env в git не коммитится (см. .gitignore).
#
# ВАЖНО: на проде (платформа awwwdde) этот файл не используется.
# Там DATABASE_URL, PUBLIC_SITE_URL, SECRET_KEY и JWT_SECRET панель
# прокидывает сама, а остальное задаётся env-переменными проекта
# в админке панели. См. DEPLOY.md.
# ─────────────────────────────────────────────────────────────

# --- Postgres (только для локального docker-compose) ---
POSTGRES_USER=perigee
POSTGRES_PASSWORD=perigee_dev_password_change_me
POSTGRES_DB=perigee

# --- Публичный адрес приложения ---
# Локально — адрес Vite. На проде панель ставит https://perigee.awwwdde.art
# Из него выводятся ORIGIN и RP_ID для WebAuthn.
PUBLIC_SITE_URL=http://localhost:5173

# --- Сессии ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string

# --- WebAuthn / passkeys (Фаза 2) ---
RP_NAME=Перигей
# RP_ID переопределять НЕ НУЖНО: по умолчанию берётся хост из PUBLIC_SITE_URL.
# Он вшивается в passkey навсегда — смена домена убивает все passkey.
# RP_ID=perigee.awwwdde.art

# --- Web Push / VAPID (Фаза 7) ---
# Сгенерировать ключи:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); v.save_key('private.pem')"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@awwwdde.art

# --- Источники мест (Фаза 5) ---
YANDEX_PLACES_API_KEY=
# 2ГИС опционален: если ключа нет — провайдер не участвует в агрегации.
TWOGIS_API_KEY=
# Город KudaGo: msk | spb | ekb | nsk | kzn | ...
KUDAGO_CITY=msk          # Москва

# --- Отладка (только локально) ---
# Вход без passkey кнопкой на онбординге: WebAuthn требует настоящего
# биометрического ключа, которого у десктопа нет.
# На боевом домене приложение с этим флагом не стартует.
DEV_AUTH_ENABLED=true

# --- Общее ---
TIMEZONE=Europe/Moscow
